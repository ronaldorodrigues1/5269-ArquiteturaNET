@using VollMed.Web.Dtos;
@model PaginatedList<VollMed.Web.Dtos.ConsultaDto>

<main class="container">
    <section class="card">
        <h2 class="title">Listagem de consultas</h2>

        <div class="table-controls">
            <a href="@Url.Action("Formulario", "Consultas" )" class="btn btn-tertiary">
                <img src="~/assets/plus.png" alt="Ícone de adicionar" class="btn-icon">
                Nova consulta
            </a>
        </div>

        <table class="tabela">
            <thead>
                <tr>
                    <th>Médico</th>
                    <th>Paciente</th>
                    <th>CPF</th>
                    <th>Data</th>
                    @* <th>Especialidade</th> *@
                    <th style="width:15%">Ações</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var consulta in Model.Items)
                {
                    <tr>
                        <td>@consulta.MedicoNome</td>
                        <td>@consulta.PacienteNome</td>
                        <td>@consulta.PacienteCpf</td>
                        <td>@consulta.Data</td>
                        @* <td>@consulta.Especialidade.GetDisplayName()</td> *@
                        <td>
                            <a href="@Url.Action("Formulario", "Consultas" , new { id=consulta.Id })" class="btn btn-edit" title="Editar">
                                <img src="~/assets/edit.svg" alt="Editar">
                            </a>
                            <a href="#deleteModal" class="btn btn-delete" data-toggle="modal" data-id="@consulta.Id" data-url="/consultas" title="Excluir">
                                <img src="~/assets/delete.svg" alt="Excluir">
                            </a>
@*                             <a href="@Url.Action("FormularioAtendimento", "Consultas", new { id=consulta.Id })" class="btn btn-atender" data-toggle="modal" data-id="@consulta.Id" data-url="/consultas" title="Atender">
                                <img src="~/assets/medic.svg" alt="Atender">
                            </a> *@
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @await Html.PartialAsync("_paginacao", Model)
    </section>
</main>

@await Html.PartialAsync("_Modal_Excluir")
